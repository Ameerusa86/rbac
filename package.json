{
  "name": "rbac",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "dotenv -o -e .env.local -- prisma generate",
    "db:migrate": "dotenv -o -e .env.local -- prisma migrate dev --name init_roles",
    "db:push": "dotenv -o -e .env.local -- prisma db push --skip-generate",
